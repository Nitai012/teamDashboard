# Copy to .env and fill in. Never commit the real .env.

# Login password hash. Generate it with:  pnpm hash-password
ADMIN_PASSWORD_HASH=

# At least 32 random characters, used to sign the session cookie.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=

# true when the app is served over HTTPS (recommended).
# Over plain HTTP on a local network keep it false, or the login will not stick.
COOKIE_SECURE=false

# true when running behind a reverse proxy (nginx, Traefik, a cloud load balancer).
TRUST_PROXY=false

# Port on the host. Inside Docker the app always listens on 3000.
PORT=3000

# SQLite file. Relative paths resolve from the API folder in development.
DATABASE_PATH=data/team-radar.db

# How long a login lasts, in hours (default 336 = 14 days).
# SESSION_TTL_HOURS=336
